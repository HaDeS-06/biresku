# Biresku Authentication Environment Variables
FLASK_SECRET_KEY=generate_a_random_32_byte_hex_string
JWT_SECRET_KEY=generate_a_random_64_byte_secret_key
REFRESH_HMAC_SECRET=generate_another_random_64_byte_secret_key
DATABASE_PATH=biresku_auth.db

# Google OAuth 2.0 (Google Cloud Console'dan alınır)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
